# Public API origin only. Leave blank for local Vite proxy; production requires the HTTPS API origin.
# Never put MongoDB credentials or backend secrets here.
VITE_API_URL=

# Firebase is used for Analytics only; account sign-in is handled by the backend.
# These web-app values are public client configuration, not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
